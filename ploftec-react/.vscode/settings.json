{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/.git/**": true,
    "**/coverage/**": true
  },
  "search.exclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/.git/**": true,
    "**/coverage/**": true
  },
  "eslint.validate": ["javascript", "typescript", "typescriptreact"],
  "editor.formatOnSave": true,
  "typescript.tsserver.maxTsServerMemory": 4096,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  }
}
